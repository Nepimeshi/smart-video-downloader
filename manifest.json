{
  "manifest_version": 3,
  "name": "Smart Video Downloader",
  "version": "3.0.0",
  "description": "Intelligent HTML5 video detector and download manager with advanced filters, queue scheduling, website profiles, and file organization.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Video Downloader",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-auto-download": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle automatic downloading"
    },
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume all downloads"
    },
    "toggle-detection-only": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Toggle Detection Only mode"
    },
    "toggle-floating-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Toggle floating video detection panel"
    }
  }
}
